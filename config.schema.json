{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sambui-Electron/W1F3/main/config.schema.json",
  "title": "W1F3 YAML configuration",
  "description": "W1F3-native YAML configuration. The modules list preserves Fastfetch module order and presentation options.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "logo": {
      "oneOf": [
        {
          "type": "string",
          "description": "Fastfetch logo name (legacy form)."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "source"
          ],
          "properties": {
            "type": {
              "const": "file"
            },
            "source": {
              "type": "string",
              "description": "Path to the custom ANSI/ASCII logo file."
            },
            "color": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[1-9]$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            },
            "padding": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "top": {
                  "type": "integer",
                  "minimum": 0
                },
                "right": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ]
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "separator": {
          "type": "string"
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "const": "break"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "break",
                  "custom",
                  "command",
                  "colors",
                  "battery",
                  "bios",
                  "bluetooth",
                  "bluetoothradio",
                  "board",
                  "bootmgr",
                  "brightness",
                  "btrfs",
                  "camera",
                  "chassis",
                  "codec",
                  "cpu",
                  "cpucache",
                  "cpuusage",
                  "cursor",
                  "datetime",
                  "display",
                  "disk",
                  "diskio",
                  "de",
                  "dns",
                  "editor",
                  "font",
                  "gamepad",
                  "gpu",
                  "host",
                  "icons",
                  "initsystem",
                  "keyboard",
                  "kernel",
                  "lm",
                  "loadavg",
                  "locale",
                  "localip",
                  "media",
                  "memory",
                  "monitor",
                  "mouse",
                  "netio",
                  "opencl",
                  "opengl",
                  "os",
                  "packages",
                  "physicaldisk",
                  "physicalmemory",
                  "player",
                  "poweradapter",
                  "processes",
                  "publicip",
                  "shell",
                  "sound",
                  "swap",
                  "terminal",
                  "terminalfont",
                  "top",
                  "terminalsize",
                  "terminaltheme",
                  "theme",
                  "tpm",
                  "uptime",
                  "users",
                  "version",
                  "vulkan",
                  "wallpaper",
                  "weather",
                  "wm",
                  "wifi",
                  "wmtheme",
                  "zpool"
                ]
              },
              "key": {
                "type": "string"
              },
              "keyColor": {
                "type": "string",
                "enum": [
                  "gray",
                  "grey",
                  "green",
                  "yellow",
                  "blue",
                  "magenta",
                  "cyan",
                  "red",
                  "white"
                ]
              },
              "format": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "shell": {
                "type": "string",
                "enum": [
                  "powershell",
                  "pwsh",
                  "cmd"
                ]
              },
              "paddingLeft": {
                "type": "integer",
                "minimum": 0
              },
              "symbol": {
                "type": "string",
                "enum": [
                  "circle",
                  "square"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "custom"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "required": [
                    "format"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "command"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "required": [
                    "text"
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    "logo_file": {
      "type": "string"
    },
    "fastfetch_path": {
      "type": "string"
    },
    "logo_palette": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9]$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
      }
    },
    "logo_padding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": "integer",
          "minimum": 0
        },
        "right": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "separator": {
      "type": "string"
    },
    "refresh": {
      "type": "number",
      "minimum": 0.2
    },
    "speed": {
      "type": "number",
      "minimum": 0
    },
    "size": {
      "type": "number",
      "minimum": 0.2
    },
    "depth": {
      "type": "number",
      "minimum": 0.1
    },
    "spin": {
      "type": "string",
      "enum": [
        "x",
        "y",
        "xy"
      ]
    },
    "height": {
      "type": "integer",
      "minimum": 0
    },
    "adaptive_scale": {
      "type": "boolean"
    },
    "adaptive_strength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "adaptive_min": {
      "type": "number",
      "minimum": 1
    },
    "adaptive_max": {
      "type": "number",
      "minimum": 1,
      "maximum": 1.5
    },
    "mouse": {
      "type": "boolean"
    },
    "color": {
      "type": "boolean"
    },
    "show_info": {
      "type": "boolean"
    },
    "box": {
      "type": "boolean"
    },
    "fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "battery",
          "bios",
          "bluetooth",
          "bluetoothradio",
          "board",
          "bootmgr",
          "brightness",
          "btrfs",
          "camera",
          "chassis",
          "codec",
          "cpu",
          "cpucache",
          "cpuusage",
          "colors",
          "cursor",
          "datetime",
          "display",
          "disk",
          "diskio",
          "de",
          "dns",
          "editor",
          "font",
          "gamepad",
          "gpu",
          "host",
          "icons",
          "initsystem",
          "keyboard",
          "kernel",
          "lm",
          "loadavg",
          "locale",
          "localip",
          "media",
          "memory",
          "monitor",
          "mouse",
          "netio",
          "opencl",
          "opengl",
          "os",
          "packages",
          "physicaldisk",
          "physicalmemory",
          "player",
          "poweradapter",
          "processes",
          "publicip",
          "shell",
          "sound",
          "swap",
          "terminal",
          "terminalfont",
          "top",
          "terminalsize",
          "terminaltheme",
          "theme",
          "tpm",
          "uptime",
          "users",
          "version",
          "vulkan",
          "wallpaper",
          "weather",
          "wm",
          "wifi",
          "wmtheme",
          "zpool"
        ]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sambui-Electron/W1F3/main/config.schema.json",
  "title": "W1F3 native configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "logo": {
      "type": "string",
      "description": "Name of a Fastfetch-provided logo."
    },
    "logo_file": {
      "type": "string",
      "description": "Path to a custom ANSI/ASCII logo file."
    },
    "fastfetch_path": {
      "type": "string"
    },
    "refresh": {
      "type": "number",
      "minimum": 0.2
    },
    "speed": {
      "type": "number",
      "minimum": 0
    },
    "size": {
      "type": "number",
      "minimum": 0.2
    },
    "depth": {
      "type": "number",
      "minimum": 0.1
    },
    "spin": {
      "enum": [
        "x",
        "y",
        "xy"
      ]
    },
    "height": {
      "type": "integer",
      "minimum": 0
    },
    "adaptive_scale": {
      "type": "boolean"
    },
    "adaptive_strength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "adaptive_min": {
      "type": "number",
      "minimum": 1
    },
    "adaptive_max": {
      "type": "number",
      "minimum": 1,
      "maximum": 1.5
    },
    "mouse": {
      "type": "boolean"
    },
    "color": {
      "type": "boolean"
    },
    "show_info": {
      "type": "boolean"
    },
    "box": {
      "type": "boolean"
    },
    "fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "battery",
          "bios",
          "bluetooth",
          "bluetoothradio",
          "board",
          "bootmgr",
          "brightness",
          "btrfs",
          "camera",
          "chassis",
          "codec",
          "cpu",
          "cpucache",
          "cpuusage",
          "colors",
          "cursor",
          "datetime",
          "display",
          "disk",
          "diskio",
          "de",
          "dns",
          "editor",
          "font",
          "gamepad",
          "gpu",
          "host",
          "icons",
          "initsystem",
          "keyboard",
          "kernel",
          "lm",
          "loadavg",
          "locale",
          "localip",
          "media",
          "memory",
          "monitor",
          "mouse",
          "netio",
          "opencl",
          "opengl",
          "os",
          "packages",
          "physicaldisk",
          "physicalmemory",
          "player",
          "poweradapter",
          "processes",
          "publicip",
          "shell",
          "sound",
          "swap",
          "terminal",
          "terminalfont",
          "top",
          "terminalsize",
          "terminaltheme",
          "theme",
          "tpm",
          "uptime",
          "users",
          "version",
          "vulkan",
          "wallpaper",
          "weather",
          "wm",
          "wifi",
          "wmtheme",
          "zpool"
        ]
      }
    },
    "logo_palette": {
      "type": "object",
      "description": "True-colour replacements for $1 through $9 markers in a logo file.",
      "propertyNames": {
        "pattern": "^[1-9]$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
      }
    },
    "logo_padding": {
      "type": "object",
      "properties": {
        "top": {
          "type": "integer",
          "minimum": 0
        },
        "right": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "separator": {
      "type": "string"
    },
    "layout": {
      "type": "array",
      "description": "Ordered W1F3 display instructions.",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "section",
              "field",
              "blank",
              "palette"
            ]
          },
          "field": {
            "type": "string",
            "enum": [
              "battery",
              "bios",
              "bluetooth",
              "bluetoothradio",
              "board",
              "bootmgr",
              "brightness",
              "btrfs",
              "camera",
              "chassis",
              "codec",
              "cpu",
              "cpucache",
              "cpuusage",
              "colors",
              "cursor",
              "datetime",
              "display",
              "disk",
              "diskio",
              "de",
              "dns",
              "editor",
              "font",
              "gamepad",
              "gpu",
              "host",
              "icons",
              "initsystem",
              "keyboard",
              "kernel",
              "lm",
              "loadavg",
              "locale",
              "localip",
              "media",
              "memory",
              "monitor",
              "mouse",
              "netio",
              "opencl",
              "opengl",
              "os",
              "packages",
              "physicaldisk",
              "physicalmemory",
              "player",
              "poweradapter",
              "processes",
              "publicip",
              "shell",
              "sound",
              "swap",
              "terminal",
              "terminalfont",
              "top",
              "terminalsize",
              "terminaltheme",
              "theme",
              "tpm",
              "uptime",
              "users",
              "version",
              "vulkan",
              "wallpaper",
              "weather",
              "wm",
              "wifi",
              "wmtheme",
              "zpool",
              "os_age"
            ]
          },
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "enum": [
              "gray",
              "grey",
              "green",
              "yellow",
              "blue",
              "magenta",
              "cyan",
              "red",
              "white"
            ]
          },
          "text": {
            "type": "string"
          },
          "padding_left": {
            "type": "integer",
            "minimum": 0
          },
          "symbol": {
            "type": "string",
            "enum": [
              "circle",
              "square"
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "field"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "field"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "section"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "text"
              ]
            }
          }
        ]
      }
    }
  }
}

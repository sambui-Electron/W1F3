{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sambui-Electron/W1F3/main/config.schema.json",
  "title": "W1F3 YAML configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "logo": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "file"
              ]
            },
            "source": {
              "type": "string"
            },
            "color": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            },
            "padding": {
              "type": "object",
              "properties": {
                "top": {
                  "type": "integer",
                  "minimum": 0
                },
                "right": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "source"
          ],
          "additionalProperties": false
        }
      ]
    },
    "logo_file": {
      "type": "string"
    },
    "fastfetch_path": {
      "type": "string"
    },
    "refresh": {
      "type": "number",
      "minimum": 0.2
    },
    "speed": {
      "type": "number",
      "minimum": 0
    },
    "size": {
      "type": "number",
      "minimum": 0.2
    },
    "depth": {
      "type": "number",
      "minimum": 0.1
    },
    "spin": {
      "enum": [
        "x",
        "y",
        "xy"
      ]
    },
    "height": {
      "type": "integer",
      "minimum": 0
    },
    "adaptive_scale": {
      "type": "boolean"
    },
    "adaptive_strength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "adaptive_min": {
      "type": "number",
      "minimum": 1
    },
    "adaptive_max": {
      "type": "number",
      "minimum": 1,
      "maximum": 1.5
    },
    "mouse": {
      "type": "boolean"
    },
    "color": {
      "type": "boolean"
    },
    "show_info": {
      "type": "boolean"
    },
    "box": {
      "type": "boolean"
    },
    "display": {
      "type": "object",
      "properties": {
        "separator": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "renderer": {
      "type": "object",
      "properties": {
        "refresh": {
          "type": "number",
          "minimum": 0.2
        },
        "speed": {
          "type": "number",
          "minimum": 0
        },
        "size": {
          "type": "number",
          "minimum": 0.2
        },
        "depth": {
          "type": "number",
          "minimum": 0.1
        },
        "spin": {
          "enum": [
            "x",
            "y",
            "xy"
          ]
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "adaptive_scale": {
          "type": "boolean"
        },
        "adaptive_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "adaptive_min": {
          "type": "number",
          "minimum": 1
        },
        "adaptive_max": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.5
        },
        "mouse": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "battery",
          "bios",
          "bluetooth",
          "bluetoothradio",
          "board",
          "bootmgr",
          "brightness",
          "btrfs",
          "camera",
          "chassis",
          "codec",
          "cpu",
          "cpucache",
          "cpuusage",
          "colors",
          "cursor",
          "datetime",
          "display",
          "disk",
          "diskio",
          "de",
          "dns",
          "editor",
          "font",
          "gamepad",
          "gpu",
          "host",
          "icons",
          "initsystem",
          "keyboard",
          "kernel",
          "lm",
          "loadavg",
          "locale",
          "localip",
          "media",
          "memory",
          "monitor",
          "mouse",
          "netio",
          "opencl",
          "opengl",
          "os",
          "packages",
          "physicaldisk",
          "physicalmemory",
          "player",
          "poweradapter",
          "processes",
          "publicip",
          "shell",
          "sound",
          "swap",
          "terminal",
          "terminalfont",
          "top",
          "terminalsize",
          "terminaltheme",
          "theme",
          "tpm",
          "uptime",
          "users",
          "version",
          "vulkan",
          "wallpaper",
          "weather",
          "wm",
          "wifi",
          "wmtheme",
          "zpool"
        ]
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "break",
              "custom",
              "colors",
              "host",
              "cpu",
              "gpu",
              "memory",
              "disk",
              "os",
              "kernel",
              "bios",
              "packages",
              "shell",
              "de",
              "lm",
              "wm",
              "wmtheme",
              "terminal",
              "os_age",
              "uptime",
              "datetime",
              "display",
              "locale"
            ]
          },
          "key": {
            "type": "string"
          },
          "key_color": {
            "type": "string",
            "enum": [
              "gray",
              "grey",
              "green",
              "yellow",
              "blue",
              "magenta",
              "cyan",
              "red",
              "white"
            ]
          },
          "format": {
            "type": "string"
          },
          "padding_left": {
            "type": "integer",
            "minimum": 0
          },
          "symbol": {
            "type": "string",
            "enum": [
              "circle",
              "square"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
